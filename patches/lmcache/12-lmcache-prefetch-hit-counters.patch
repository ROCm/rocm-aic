+class _AccumulatingCounter:
+    """Thread-safe accumulator for observable OTel counters.
+
+    Callers call .add(amount, attributes) like a synchronous counter;
+    accumulated totals are reported via OTel observable counter callback
+    on each Prometheus scrape.
+    """
+
+    def __init__(self):
+        import threading
+        self._lock = threading.Lock()
+        self._values = {}
+
+    def add(self, amount, attributes=None):
+        key = tuple(sorted((attributes or {}).items()))
+        with self._lock:
+            self._values[key] = self._values.get(key, 0) + amount
+
+    def observations(self):
+        with self._lock:
+            return [(v, dict(k)) for k, v in self._values.items()]
+
+
+def register_observable_counter(meter_name, counter_name, description):
+    """Register an OTel observable counter backed by an _AccumulatingCounter.
+
+    Uses create_observable_counter (async instrument) so values are reported
+    via callback on each Prometheus scrape, matching register_gauge and
+    compatible with the prometheus_client REGISTRY used by lmcache /metrics.
+
+    Returns an _AccumulatingCounter whose .add() is safe from any thread.
+    """
+    acc = _AccumulatingCounter()
+    try:
+        from opentelemetry import metrics as otel_metrics
+
+        def _callback(_options):
+            return [
+                otel_metrics.Observation(value, attrs)
+                for value, attrs in acc.observations()
+            ]
+
+        meter = otel_metrics.get_meter(meter_name)
+        meter.create_observable_counter(
+            counter_name,
+            callbacks=[_callback],
+            description=description,
+        )
+    except Exception:
+        logger.debug(
+            "opentelemetry not available, skipping observable counter %s",
+            counter_name,
+        )
+    return acc
