# Re-ported for LMCache v0.5.5 (05a013b). v0.5.5 restructured DeviceMessagingFuture;
# the fix is now only wrapping import_event since wait/query already handle event_=None.
#
# Extended: on ROCm, always skip the IPC event and use raw ZMQ future polling.
# import_event can return a corrupt-but-non-raising handle (freed SHM) causing
# query_event() to permanently return False → EngineCore busy-loop at 200% CPU
# with "Running: 1 reqs" stuck in WAITING_FOR_REMOTE_KVS forever.
#
diff --git a/lmcache/v1/multiprocess/futures.py b/lmcache/v1/multiprocess/futures.py
index bb77f4b..9dd2564 100644
--- a/lmcache/v1/multiprocess/futures.py
+++ b/lmcache/v1/multiprocess/futures.py
@@ -188,7 +188,14 @@ class DeviceMessagingFuture(MessagingFuture[T]):
         event_bytes, result = self.raw_future_.result()
         event = None
-        if event_bytes:
-            event = self._event_backend.import_event(event_bytes, self.device_)
+        if event_bytes and not __import__('torch').version.hip:
+            try:
+                event = self._event_backend.import_event(event_bytes, self.device_)
+            except Exception:
+                event = None
+        # On ROCm: always event=None to avoid livelock when import_event
+        # silently returns a corrupt handle that query_event() never signals.
+        # ZMQ raw-future polling is the safe fallback on all ROCm platforms.

         self.result_ = result
         self.event_ = event
