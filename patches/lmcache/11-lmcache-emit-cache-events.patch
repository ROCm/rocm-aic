+        assert objs is not None
+        media = [allocator.is_devdax_obj(obj) for obj in objs]
+        assert media == [False, False, True, True]
+        allocator.batched_free(objs)
+        del objs
+        gc.collect()
+    finally:
+        allocator.close()
