+def test_second_store_keeps_first_store_pending(fake_adapter):
+    """A request's second store must not drop its first, still-pending one.
+
+    Dropping it destroyed the first store's exported event before the server
+    imported it (HIP: hipErrorInvalidValue, store skipped), and let the
+    request finish while the first store was still reading its blocks.
+    """
+    adapter, _send_mock, _future = fake_adapter
+    first_future = MagicMock(name="first_future")
+    second_future = MagicMock(name="second_future")
+    first_future.query.return_value = False
+    second_future.query.return_value = True
+    first_future.result.return_value = True
+    second_future.result.return_value = True
+    transfer_ctx = MagicMock()
+    transfer_ctx.submit_store.side_effect = [first_future, second_future]
+    adapter.transfer_ctx = transfer_ctx
+
+    first_event = FakeCudaEvent()
+    first_ref = weakref.ref(first_event)
+    op = LoadStoreOp(token_ids=[1, 2], block_ids=[[7]], start=0, end=2)
+    adapter.submit_store_request("req-1", op, first_event)
+    adapter.submit_store_request("req-1", op, FakeCudaEvent())
+    transfer_ctx.reset_mock()  # its call record also holds the events
+    del first_event
+    gc.collect()
+    assert first_ref() is not None
+
+    finished_stores, _ = adapter.get_finished({"req-1"})
+    assert finished_stores == set()
+    assert first_ref() is not None
+
+    first_future.query.return_value = True
+    finished_stores, _ = adapter.get_finished(set())
+    assert finished_stores == {"req-1"}
+    assert "req-1" not in adapter.store_events
+    gc.collect()
+    assert first_ref() is None
+
+
+def test_failed_earlier_store_fails_the_request(fake_adapter):
+    adapter, _send_mock, _future = fake_adapter
+    futures = [MagicMock(name="f0"), MagicMock(name="f1")]
+    for f, ok in zip(futures, (False, True), strict=True):
+        f.query.return_value = True
+        f.result.return_value = ok
+    transfer_ctx = MagicMock()
+    transfer_ctx.submit_store.side_effect = futures
+    adapter.transfer_ctx = transfer_ctx
+    op = LoadStoreOp(token_ids=[1, 2], block_ids=[[7]], start=0, end=2)
+    adapter.submit_store_request("req-1", op, FakeCudaEvent())
+    adapter.submit_store_request("req-1", op, FakeCudaEvent())
+
+    assert adapter.store_futures["req-1"].result() is False
+
+
