+def test_drop_instance_removes_all_its_placements():
+    directory = KeyDirectory()
+    directory.apply_batch(_batch(instance_id="node-a", keys=[_key(1), _key(2)]))
+    directory.apply_batch(_batch(instance_id="node-b", keys=[_key(1)]))
