# Build lmcache.c_ops with hipcc without forcing hipcc on every extension
#
# LMCache collects the common C++ extensions, the ROCm c_ops extension, and the
# optional host-only storage backends into a single build_ext command, so the
# whole wheel is built by one process-global compiler.  A ROCm build therefore
# had to run with CXX=hipcc, which also handed hipcc the host-only sources of
# the optional Mooncake L2 backend (ASIO plus coroutine headers) and of the
# common C++ extensions, which do not compile that way.
#
# This patch makes the compiler a per-extension property instead:
#
#   setup_extensions/build_ext.py  new module.  An extension carrying the
#       private _lmcache_cxx attribute is built with that program.  Around it,
#       both the CXX environment variable (read by torch when it writes the
#       ninja build file) and the command head of every compiler/linker
#       executable array present on the distutils compiler object (used by the
#       non-ninja compile path and by the link step) are switched, then
#       restored in a finally block, including on failure.  Because both are
#       process global, a parallel build_ext is rejected while any extension
#       carries the attribute; MAX_JOBS and ninja parallelism inside a single
#       extension are unaffected.
#
#   setup_extensions/build_profiles/rocm.py  tags only lmcache.c_ops (its host
#       .cpp sources include HIP headers) with the resolved hipcc, overridable
#       through LMCACHE_ROCM_CXX, and returns the new command class.  Common
#       C++ and any storage backend extension keep the base compiler, so a
#       ROCm build can now run with CXX set to the ordinary host compiler.
#
# tests/setup_extensions/test_build_ext.py covers the switch, restoration after
# an exception, absent executable arrays on older setuptools, and the parallel
# rejection.
#
diff --git a/setup_extensions/build_ext.py b/setup_extensions/build_ext.py
new file mode 100644
index 0000000..616c11c
--- /dev/null
+++ b/setup_extensions/build_ext.py
@@ -0,0 +1,178 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Per-extension C++ compiler selection for ``build_ext``.
+
+Every LMCache extension is collected into a single ``build_ext`` command, so
+one process-global compiler otherwise has to serve extensions with
+incompatible toolchain requirements.  On ROCm the host ``.cpp`` sources of
+``lmcache.c_ops`` include HIP headers and need ``hipcc``, while the common C++
+extensions and the optional host-only storage backends (Mooncake, for example,
+pulls in ASIO and coroutine headers) must be built by the ordinary host
+compiler.
+
+An extension opts into its own compiler by carrying the private
+:data:`CXX_ATTR` attribute.  While that one extension is built, two things are
+switched together and restored afterwards:
+
+* the ``CXX`` environment variable, which is what torch reads when it writes
+  the ninja build file (``torch.utils.cpp_extension.get_cxx_compiler``);
+* the command head of every compiler and linker executable array on the
+  distutils compiler object, which is what the non-ninja compile path and the
+  link step use.
+
+Both are process global, so a parallel ``build_ext`` is rejected while any
+extension carries the attribute.  Parallelism *inside* one extension
+(``MAX_JOBS`` and ninja) is unaffected.
+"""
+
+# Standard
+from contextlib import contextmanager
+from typing import Any, Iterator, Optional, Sequence, Union
+import os
+import shlex
+
+#: Private attribute an ``Extension`` carries to request its own C++ compiler.
+CXX_ATTR = "_lmcache_cxx"
+
+#: Environment variable torch reads to pick the C++ compiler for ninja.
+CXX_ENV = "CXX"
+
+#: Executable arrays whose command head follows the selected compiler.  Which
+#: ones exist depends on the setuptools version (the ``*_cxx`` variants are
+#: newer), so every name is treated as optional.
+EXECUTABLE_ATTRS = (
+    "compiler",
+    "compiler_so",
+    "compiler_cxx",
+    "compiler_so_cxx",
+    "linker_so",
+    "linker_so_cxx",
+    "linker_exe",
+    "linker_exe_cxx",
+)
+
+
+def _program_index(argv: Sequence[str]) -> int:
+    """Index of the program inside *argv*.
+
+    Mirrors distutils: a command may be wrapped as ``env VAR=value program``,
+    in which case the program follows the assignments.
+    """
+    if not argv:
+        raise ValueError("empty compiler command")
+    if os.path.basename(argv[0]) != "env":
+        return 0
+    index = 1
+    while index < len(argv) and "=" in argv[index]:
+        index += 1
+    if index >= len(argv):
+        raise ValueError("no program found in compiler command: %r" % (list(argv),))
+    return index
+
+
+def replace_program(command: Union[str, Sequence[str]], program: str) -> list[str]:
+    """Return *command* with its program replaced by *program*.
+
+    Flags are preserved: only the program itself changes.
+    """
+    argv = shlex.split(command) if isinstance(command, str) else list(command)
+    argv[_program_index(argv)] = program
+    return argv
+
+
+def rejects_parallel(parallel: Any) -> bool:
+    """Return True when *parallel* would build extensions concurrently."""
+    if parallel is None or parallel is False:
+        return False
+    if parallel is True:
+        return True
+    try:
+        return int(parallel) > 1
+    except (TypeError, ValueError):
+        # An unparsable value is treated as parallel: fail closed.
+        return True
+
+
+@contextmanager
+def compiler_override(compiler: Any, program: str) -> Iterator[None]:
+    """Point *compiler* and ``CXX`` at *program* for the duration of the block.
+
+    Every value that is changed is restored in ``finally``, including when the
+    body raises, so a failed extension cannot leak the compiler switch into the
+    extensions built after it.
+    """
+    saved_env: Optional[str] = os.environ.get(CXX_ENV)
+    saved_executables = {
+        name: getattr(compiler, name)
+        for name in EXECUTABLE_ATTRS
+        if getattr(compiler, name, None)
+    }
+    try:
+        os.environ[CXX_ENV] = program
+        for name, command in saved_executables.items():
+            setattr(compiler, name, replace_program(command, program))
+        yield
+    finally:
+        for name, command in saved_executables.items():
+            setattr(compiler, name, command)
+        if saved_env is None:
+            os.environ.pop(CXX_ENV, None)
+        else:
+            os.environ[CXX_ENV] = saved_env
+
+
+class PerExtensionCompilerMixin:
+    """``build_ext`` mixin that honors :data:`CXX_ATTR` on an extension."""
+
+    def _tagged_extensions(self) -> list:
+        return [
+            ext
+            for ext in (getattr(self, "extensions", None) or [])
+            if getattr(ext, CXX_ATTR, None)
+        ]
+
+    def build_extensions(self) -> None:
+        """Reject concurrent extension builds while a compiler switch is live."""
+        tagged = self._tagged_extensions()
+        if tagged and rejects_parallel(getattr(self, "parallel", None)):
+            raise RuntimeError(
+                "build_ext --parallel cannot be combined with a per-extension "
+                "compiler (%s). The switch changes the CXX environment "
+                "variable and the shared compiler object, which are process "
+                "global. Build serially; MAX_JOBS still parallelizes the "
+                "compilation inside each extension."
+                % ", ".join(ext.name for ext in tagged)
+            )
+        super().build_extensions()  # type: ignore[misc]
+
+    def build_extension(self, ext: Any) -> None:
+        """Build *ext*, switching compilers when it asked for its own."""
+        program = getattr(ext, CXX_ATTR, None)
+        if not program:
+            super().build_extension(ext)  # type: ignore[misc]
+            return
+        print("Building %s with %s" % (ext.name, program))
+        with compiler_override(self.compiler, program):  # type: ignore[attr-defined]
+            super().build_extension(ext)  # type: ignore[misc]
+
+
+_BUILD_EXTENSION: Optional[type] = None
+
+
+def lmcache_build_extension() -> type:
+    """Return the ``build_ext`` command class used by LMCache.
+
+    torch is imported lazily, matching the rest of ``setup_extensions``: the
+    module must stay importable before the build requirements are installed.
+    """
+    global _BUILD_EXTENSION
+    if _BUILD_EXTENSION is None:
+        # Third Party
+        from torch.utils import cpp_extension
+
+        class LMCacheBuildExtension(  # type: ignore[misc]
+            PerExtensionCompilerMixin, cpp_extension.BuildExtension
+        ):
+            """torch's ``BuildExtension`` with per-extension compiler choice."""
+
+        _BUILD_EXTENSION = LMCacheBuildExtension
+    return _BUILD_EXTENSION
