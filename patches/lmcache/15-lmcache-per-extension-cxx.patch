+++ b/tests/setup_extensions/test_build_ext.py
@@ -0,0 +1,268 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for the per-extension C++ compiler switch used by ``build_ext``."""
+
+# Standard
+from pathlib import Path
+import os
+import sys
+
+# Third Party
+import pytest
+
+ROOT_DIR = Path(__file__).resolve().parents[2]
+if str(ROOT_DIR) not in sys.path:
+    sys.path.insert(0, str(ROOT_DIR))
+
+# First Party
+from setup_extensions.build_ext import (  # noqa: E402
+    CXX_ATTR,
+    CXX_ENV,
+    EXECUTABLE_ATTRS,
+    PerExtensionCompilerMixin,
+    compiler_override,
+    rejects_parallel,
+    replace_program,
+)
+
+
+class FakeCompiler:
+    """Stand-in for a distutils ``UnixCCompiler``.
+
+    Only a subset of the executable arrays is defined, which is what an older
+    setuptools looks like.
+    """
+
+    def __init__(self):
+        self.compiler = ["gcc", "-O2"]
+        self.compiler_so = ["gcc", "-O2", "-fPIC"]
+        self.compiler_cxx = ["g++", "-O2"]
+        self.linker_so = ["gcc", "-shared"]
+        self.linker_exe = ["gcc"]
+
+
+class FakeExtension:
+    def __init__(self, name, cxx=None):
+        self.name = name
+        if cxx is not None:
+            setattr(self, CXX_ATTR, cxx)
+
+
+class RecordingBuildExt:
+    """Minimal ``build_ext`` stand-in recording what the mixin delegates."""
+
+    def __init__(self, extensions, parallel=None, fail_on=None):
+        self.extensions = extensions
+        self.parallel = parallel
+        self.compiler = FakeCompiler()
+        self.built = []
+        self.seen = []
+        self._fail_on = fail_on
+
+    def build_extensions(self):
+        for ext in self.extensions:
+            self.build_extension(ext)
+
+    def build_extension(self, ext):
+        self.built.append(ext.name)
+        self.seen.append(
+            (
+                os.environ.get(CXX_ENV),
+                list(self.compiler.compiler_cxx),
+                list(self.compiler.linker_so),
+            )
+        )
+        if self._fail_on == ext.name:
+            raise RuntimeError("compile failed for %s" % ext.name)
+
+
+class Command(PerExtensionCompilerMixin, RecordingBuildExt):
+    pass
+
+
+@pytest.fixture
+def clean_cxx(monkeypatch):
+    monkeypatch.delenv(CXX_ENV, raising=False)
+    return monkeypatch
+
+
+# ---------------------------------------------------------------------------
+# replace_program
+# ---------------------------------------------------------------------------
+
+
+def test_replace_program_keeps_flags():
+    assert replace_program(["gcc", "-O2", "-fPIC"], "hipcc") == [
+        "hipcc",
+        "-O2",
+        "-fPIC",
+    ]
+
+
+def test_replace_program_accepts_a_string():
+    assert replace_program("gcc -O2", "/opt/rocm/bin/hipcc") == [
+        "/opt/rocm/bin/hipcc",
+        "-O2",
+    ]
+
+
+def test_replace_program_skips_env_prefix():
+    command = ["/usr/bin/env", "LC_ALL=C", "gcc", "-O2"]
+    assert replace_program(command, "hipcc") == [
+        "/usr/bin/env",
+        "LC_ALL=C",
+        "hipcc",
+        "-O2",
+    ]
+
+
+def test_replace_program_rejects_an_empty_command():
+    with pytest.raises(ValueError):
+        replace_program([], "hipcc")
+
+
+# ---------------------------------------------------------------------------
+# compiler_override
+# ---------------------------------------------------------------------------
+
+
+def test_override_switches_env_and_executables(clean_cxx):
+    compiler = FakeCompiler()
+    with compiler_override(compiler, "hipcc"):
+        assert os.environ[CXX_ENV] == "hipcc"
+        assert compiler.compiler_so == ["hipcc", "-O2", "-fPIC"]
+        assert compiler.compiler_cxx == ["hipcc", "-O2"]
+        assert compiler.linker_so == ["hipcc", "-shared"]
+        assert compiler.linker_exe == ["hipcc"]
+
+
+def test_override_restores_every_value(clean_cxx):
+    clean_cxx.setenv(CXX_ENV, "/usr/bin/g++")
+    compiler = FakeCompiler()
+    before = {name: getattr(compiler, name) for name in EXECUTABLE_ATTRS if hasattr(compiler, name)}
+    with compiler_override(compiler, "hipcc"):
+        pass
+    assert os.environ[CXX_ENV] == "/usr/bin/g++"
+    for name, value in before.items():
+        assert getattr(compiler, name) == value
+
+
+def test_override_restores_after_an_exception(clean_cxx):
+    clean_cxx.setenv(CXX_ENV, "/usr/bin/g++")
+    compiler = FakeCompiler()
+    before = {name: getattr(compiler, name) for name in EXECUTABLE_ATTRS if hasattr(compiler, name)}
+    with pytest.raises(RuntimeError):
+        with compiler_override(compiler, "hipcc"):
+            raise RuntimeError("compile failed")
+    assert os.environ[CXX_ENV] == "/usr/bin/g++"
+    for name, value in before.items():
+        assert getattr(compiler, name) == value
+
+
+def test_override_unsets_cxx_when_it_was_unset(clean_cxx):
+    with compiler_override(FakeCompiler(), "hipcc"):
+        assert os.environ[CXX_ENV] == "hipcc"
+    assert CXX_ENV not in os.environ
+
+
+def test_override_ignores_absent_executables(clean_cxx):
+    compiler = FakeCompiler()
+    assert not hasattr(compiler, "compiler_so_cxx")
+    with compiler_override(compiler, "hipcc"):
+        assert not hasattr(compiler, "compiler_so_cxx")
+
+
+def test_override_switches_every_present_executable(clean_cxx):
+    compiler = FakeCompiler()
+    compiler.compiler_so_cxx = ["g++", "-O2", "-fPIC"]
+    compiler.linker_so_cxx = ["g++", "-shared"]
+    compiler.linker_exe_cxx = ["g++"]
+    with compiler_override(compiler, "hipcc"):
+        for name in EXECUTABLE_ATTRS:
+            assert getattr(compiler, name)[0] == "hipcc", name
+
+
+# ---------------------------------------------------------------------------
+# parallel rejection
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("value", [None, False, 0, 1, "1"])
+def test_serial_values_are_accepted(value):
+    assert rejects_parallel(value) is False
+
+
+@pytest.mark.parametrize("value", [True, 2, "8", "yes"])
+def test_parallel_values_are_rejected(value):
+    assert rejects_parallel(value) is True
+
+
+def test_build_extensions_rejects_parallel_with_a_tagged_extension(clean_cxx):
+    command = Command([FakeExtension("lmcache.c_ops", cxx="hipcc")], parallel=4)
+    with pytest.raises(RuntimeError, match="parallel"):
+        command.build_extensions()
+    assert command.built == []
+
+
+def test_build_extensions_allows_parallel_without_a_tagged_extension(clean_cxx):
+    command = Command([FakeExtension("lmcache.lmcache_fs")], parallel=4)
+    command.build_extensions()
+    assert command.built == ["lmcache.lmcache_fs"]
+
+
+# ---------------------------------------------------------------------------
+# build_extension
+# ---------------------------------------------------------------------------
+
+
+def test_only_the_tagged_extension_sees_the_switch(clean_cxx):
+    clean_cxx.setenv(CXX_ENV, "/usr/bin/g++")
+    command = Command(
+        [
+            FakeExtension("lmcache.c_ops", cxx="/opt/rocm/bin/hipcc"),
+            FakeExtension("lmcache.lmcache_mooncake"),
+        ]
+    )
+    command.build_extensions()
+    assert command.built == ["lmcache.c_ops", "lmcache.lmcache_mooncake"]
+    hip_env, hip_cxx, hip_link = command.seen[0]
+    host_env, host_cxx, host_link = command.seen[1]
+    assert hip_env == "/opt/rocm/bin/hipcc"
+    assert hip_cxx[0] == "/opt/rocm/bin/hipcc"
+    assert hip_link[0] == "/opt/rocm/bin/hipcc"
+    assert host_env == "/usr/bin/g++"
+    assert host_cxx == ["g++", "-O2"]
+    assert host_link == ["gcc", "-shared"]
+    assert os.environ[CXX_ENV] == "/usr/bin/g++"
+
+
+def test_a_failed_tagged_extension_restores_the_toolchain(clean_cxx):
+    clean_cxx.setenv(CXX_ENV, "/usr/bin/g++")
+    command = Command(
+        [FakeExtension("lmcache.c_ops", cxx="hipcc")], fail_on="lmcache.c_ops"
+    )
+    with pytest.raises(RuntimeError, match="compile failed"):
+        command.build_extensions()
+    assert os.environ[CXX_ENV] == "/usr/bin/g++"
+    assert command.compiler.compiler_cxx == ["g++", "-O2"]
+    assert command.compiler.compiler_so == ["gcc", "-O2", "-fPIC"]
+    assert command.compiler.linker_so == ["gcc", "-shared"]
+
+
+# ---------------------------------------------------------------------------
+# wiring
+# ---------------------------------------------------------------------------
+
+
+def test_rocm_profile_tags_only_c_ops(monkeypatch):
+    pytest.importorskip("torch")
+    monkeypatch.setenv("LMCACHE_ROCM_CXX", "/opt/rocm/bin/hipcc")
+    # First Party
+    from setup_extensions.build_ext import lmcache_build_extension
+    from setup_extensions.build_profiles import rocm
+
+    monkeypatch.setattr(rocm, "_hipify_wrapper", lambda: [])
+    ext_modules, cmdclass = rocm.RocmProfile().build()
+    assert [ext.name for ext in ext_modules] == ["lmcache.c_ops"]
+    assert getattr(ext_modules[0], CXX_ATTR) == "/opt/rocm/bin/hipcc"
+    assert cmdclass["build_ext"] is lmcache_build_extension()
+    assert issubclass(cmdclass["build_ext"], PerExtensionCompilerMixin)
