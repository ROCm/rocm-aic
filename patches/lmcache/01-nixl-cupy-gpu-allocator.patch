# lmcache: CuPy-backed GPU buffer allocator for the NIXL MP connector
#
# Context
# -------
# The NIXL MP connector allocates a staging GPU buffer via torch.empty(device="cuda").
# On ROCm, importing libtorch_hip.so triggers DT_NEEDED resolution of
# librocblas, libMIOpen, librccl, libhipblaslt, etc. even though LMCache
# never invokes GPU compute kernels — it only does GPU <-> CPU DMA.
#
# NIXL registration is entirely pointer-based: register_memory() accepts
# (ptr: int, size: int, device_id: int, meta: str) tuples and never holds
# a reference to any Python tensor object. After data_ptr() is extracted,
# PyTorch plays no further role in the DMA hot path.
#
# Fix
# ---
# When LMCACHE_NIXL_USE_CUPY=1 (opt-in), replace torch.empty(device="cuda")
# with cupy.cuda.alloc() (hipMalloc). cupy-rocm-7-0 links only against
# libamdhip64.so + libhsa-runtime64.so — no compute libraries.
# PagedCuPyMemoryAllocator (shipped separately and COPYed into the image)
# provides the same interface as PagedTensorMemoryAllocator so the NIXL
# backend is unchanged post-construction.
#
# The existing torch path is the default and is not modified.
#
# Applies to: LMCache v0.5.5 (commit 05a013b)
#
diff --git a/lmcache/v1/memory_management.py b/lmcache/v1/memory_management.py
--- a/lmcache/v1/memory_management.py
+++ b/lmcache/v1/memory_management.py
@@ -616,6 +616,62 @@ def _allocate_gpu_memory(
     return base_buffer, aligned_buffer


+def _have_cupy() -> bool:
+    """True when cupy (ROCm or CUDA variant) is importable."""
+    try:
+        import cupy  # noqa: F401
+        return True
+    except ImportError:
+        return False
+
+
+class CuPyGpuRegion:
+    """
+    Keeps a cupy.cuda.MemoryPointer alive and exposes data_ptr() so the
+    NIXL backend can treat it identically to the torch.Tensor 'base_buffer'
+    returned by _allocate_gpu_memory().
+    """
+
+    def __init__(self, memptr, aligned_view) -> None:
+        self._memptr = memptr
+        self.aligned_view = aligned_view
+
+    def data_ptr(self) -> int:
+        return int(self._memptr.ptr)
+
+
+def _allocate_gpu_memory_cupy(
+    size: int,
+    device: str,
+) -> "tuple[CuPyGpuRegion, cupy.ndarray]":
+    """
+    Allocate a page-aligned GPU buffer via hipMalloc (CuPy).
+
+    Returns (region, aligned_ndarray) matching _allocate_gpu_memory()'s
+    (base_buffer, aligned_buffer) signature so call sites are identical.
+    Only requires libamdhip64.so + libhsa-runtime64.so at runtime.
+    """
+    import cupy
+
+    dev_id = int(device.split(":")[-1]) if ":" in device else 0
+    page_size = os.sysconf("SC_PAGESIZE")
+
+    with cupy.cuda.Device(dev_id):
+        memptr = cupy.cuda.alloc(size + page_size)
+        base_ptr = int(memptr.ptr)
+        offset = (-base_ptr) % page_size
+        aligned = cupy.ndarray(
+            (size,),
+            dtype=cupy.uint8,
+            memptr=cupy.cuda.MemoryPointer(memptr.mem, offset),
+        )
+
+    return CuPyGpuRegion(memptr, aligned), aligned
+
+
+def _nixl_use_cupy() -> bool:
+    """True when the operator opts into the CuPy GPU allocator."""
+    return os.environ.get("LMCACHE_NIXL_USE_CUPY", "0") == "1" and _have_cupy()
+
+
diff --git a/lmcache/v1/storage_backend/nixl_storage_backend.py b/lmcache/v1/storage_backend/nixl_storage_backend.py
--- a/lmcache/v1/storage_backend/nixl_storage_backend.py
+++ b/lmcache/v1/storage_backend/nixl_storage_backend.py
@@ -74,9 +74,17 @@ from lmcache.v1.memory_management import (
     MemoryFormat,
     TensorMemoryObj,
     _allocate_cpu_memory,
-    _allocate_gpu_memory,
+    _allocate_gpu_memory,
+    _allocate_gpu_memory_cupy,
+    _nixl_use_cupy,
     logger,
 )
+try:
+    from lmcache.v1.memory_allocators.paged_cupy_memory_allocator import (
+        PagedCuPyMemoryAllocator,
+    )
+except ImportError:
+    PagedCuPyMemoryAllocator = None  # type: ignore[assignment,misc]
 from lmcache.v1.memory_allocators.paged_tensor_memory_allocator import (
     PagedTensorMemoryAllocator,
 )
@@ -920,12 +928,22 @@ class NixlStorageBackend:
         else:
             if self.use_hugepages:
                 logger.warning("Hugepages are not supported for GPU memory allocation")
                 self.use_hugepages = False
-            base_buffer, self.buffer = _allocate_gpu_memory(
-                config.nixl_buffer_size, corrected_device
-            )
-            torch_dev.set_device(corrected_device)
-            self.base_buffer = base_buffer  # Prevents early GC of the aligned tensor.
+            if _nixl_use_cupy() and PagedCuPyMemoryAllocator is not None:
+                logger.info(
+                    "NIXL GPU buffer: CuPy allocator (LMCACHE_NIXL_USE_CUPY=1) — "
+                    "librocblas/libMIOpen not required."
+                )
+                base_region, self.buffer = _allocate_gpu_memory_cupy(
+                    config.nixl_buffer_size, corrected_device
+                )
+                self.base_buffer = base_region
+            else:
+                base_buffer, self.buffer = _allocate_gpu_memory(
+                    config.nixl_buffer_size, corrected_device
+                )
+                torch_dev.set_device(corrected_device)
+                self.base_buffer = base_buffer
             self.free_pinned_buffer = False

-        return PagedTensorMemoryAllocator(
-            self.buffer,
-            [torch.Size(metadata.kv_shape)],
-            [metadata.kv_dtype],
-            MemoryFormat.KV_2LTD,
-        )
+        if (_nixl_use_cupy() and PagedCuPyMemoryAllocator is not None
+                and corrected_device != "cpu"):
+            return PagedCuPyMemoryAllocator(
+                self.buffer,
+                [torch.Size(metadata.kv_shape)],
+                [metadata.kv_dtype],
+                MemoryFormat.KV_2LTD,
+            )
+        return PagedTensorMemoryAllocator(
+            self.buffer,
+            [torch.Size(metadata.kv_shape)],
+            [metadata.kv_dtype],
+            MemoryFormat.KV_2LTD,
+        )
