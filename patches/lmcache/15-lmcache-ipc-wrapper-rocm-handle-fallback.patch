+    def _to_storage_fallback(self, device_index: int) -> torch.UntypedStorage:
+        """Three-stage fallback for source-built ROCm PyTorch 2.13 handle size mismatch.
+
+        Source-built ROCm/pytorch@release/2.13 returns a 66-byte handle from
+        UntypedStorage._share_cuda_() instead of the 64-byte hipIpcMemHandle_t
+        that hipIpcOpenMemHandle expects.  Each stage strips more header bytes.
+        """
+        import ctypes
+        import ctypes.util
+
+        handle_bytes = self.handle[1]
+        empty_aux = b""
+
+        # Stage 1: retry without auxiliary handles
+        try:
+            return torch.UntypedStorage._new_shared_cuda(  # noqa: SLF001
+                device_index, handle_bytes, empty_aux, empty_aux
+            )
+        except (RuntimeError, Exception):
+            pass
+
+        # Stage 2: strip 2-byte PyTorch-prepended prefix to recover 64-byte handle
+        if len(handle_bytes) >= 66:
+            stripped = handle_bytes[2:]
+            try:
+                return torch.UntypedStorage._new_shared_cuda(  # noqa: SLF001
+                    device_index, stripped, empty_aux, empty_aux
+                )
+            except (RuntimeError, Exception):
+                pass
+            # Stage 3: open via ctypes and feed back a fresh 64-byte bytes
+            try:
+                libamdhip = ctypes.CDLL("libamdhip64.so")
+                ptr = ctypes.c_void_p()
+                raw_handle = (ctypes.c_char * 64)(*stripped[:64])
+                rc = libamdhip.hipIpcOpenMemHandle(
+                    ctypes.byref(ptr), raw_handle, 0
+                )
+                if rc == 0 and ptr.value:
+                    handle64 = bytes(raw_handle)
+                    return torch.UntypedStorage._new_shared_cuda(  # noqa: SLF001
+                        device_index, handle64, empty_aux, empty_aux
+                    )
+            except Exception:
+                pass
+
+        raise RuntimeError(
+            f"CudaIPCWrapper: all fallback stages failed for handle len={len(handle_bytes)}"
+        )
+
 
