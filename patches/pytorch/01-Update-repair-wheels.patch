From: Jorge Bellon Castro <jorgeb@amd.com>
Subject: [PATCH] Update repair_wheel.py to work with ROCm deb packages

Does no longer bundle .so libraries with the wheel file
Sets RPATH to ROCm library directories

Rebased onto ROCm/pytorch release/2.15, where the script moved to
.ci/wheel/linux/ and rejects any ROCM_HOME that is not a TheRock SDK layout.
---
--- a/.ci/wheel/linux/repair_wheel.py
+++ b/.ci/wheel/linux/repair_wheel.py
@@ -30,7 +30,7 @@
 from build_env_setup import PLATFORM_TAGS


-PATCHELF = "/usr/local/bin/patchelf"
+PATCHELF = "/usr/bin/patchelf"


 def wheel_platform_tags(wheel_name: str) -> list[str]:
@@ -250,10 +250,18 @@
         # A classic install has no _rocm_sdk_* siblings, so SDK RPATHs
         # would not resolve. CI images always use the TheRock layout.
         if "_rocm_sdk" not in str(rocm_home):
-            sys.exit(
-                f"Only the TheRock SDK layout is supported (ROCM_HOME={rocm_home})"
+            # ROCm deb-package layout: nothing is bundled, so point RPATHs
+            # at the system ROCm library directories.
+            rpaths = ":".join(
+                [
+                    f"{rocm_home}/lib",
+                    f"{rocm_home}/lib/host-math/lib",
+                    f"{rocm_home}/lib/llvm/lib",
+                    f"{rocm_home}/lib/rocm_sysdeps/lib",
+                ]
             )
-        rpaths = rocm_rpaths(rocm_home)
+        else:
+            rpaths = rocm_rpaths(rocm_home)
         c_so_rpath = f"{rpaths}:$ORIGIN:$ORIGIN/lib"
         lib_so_rpath = f"{rpaths}:$ORIGIN"
         force_rpath = True
