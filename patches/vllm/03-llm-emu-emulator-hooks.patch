 class UniProcExecutor(Executor):
     def _init_executor(self) -> None:
         """Initialize the worker and load the model."""
+        # LLM-Emu executor hook (opt-in via VLLM_EMULATOR_EXECUTOR_HOOK=1).
+        # When active, execute_model()/sample_tokens() below never reach the
+        # worker: the hook returns a Future that resolves after the step
+        # latency drawn from an offline profile pack.  Left as None -- and so
+        # costing one `is None` test per step -- in every other configuration.
+        self._emulator_executor_hook = None
+        if os.environ.get("VLLM_EMULATOR_EXECUTOR_HOOK", "").lower() in (
+            "1",
+            "true",
+            "yes",
+        ):
+            try:
+                from vllm_emulator.hooks.executor_hook import get_executor_hook
+
+                self._emulator_executor_hook = get_executor_hook()
+            except ImportError:
+                logger.warning(
+                    "VLLM_EMULATOR_EXECUTOR_HOOK is set but the vllm_emulator "
+                    "package is not installed; emulation is disabled."
+                )
+            if self._emulator_executor_hook is None:
+                logger.warning(
+                    "VLLM_EMULATOR_EXECUTOR_HOOK is set but the emulator hook "
+                    "did not activate (VLLM_EMULATOR_ENABLE_ORACLE unset or "
+                    "profile pack missing/invalid); running the real model."
+                )
+            else:
+                logger.info(
+                    "LLM-Emu executor hook active: the model forward pass is "
+                    "replaced by profile-pack latency."
+                )
+
         self.driver_worker = WorkerWrapperBase(rpc_rank=0)
         distributed_init_method, rank, local_rank = self._distributed_args()
         kwargs = dict(
@@ -108,6 +140,18 @@ class UniProcExecutor(Executor):
     def execute_model(  # type: ignore[override]
         self, scheduler_output: SchedulerOutput, non_block: bool = False
     ) -> ModelRunnerOutput | None | Future[ModelRunnerOutput | None]:
+        # Emulator fast path: return a timer-based Future that resolves after
+        # the predicted GPU time.  This preserves the engine core's batch-queue
+        # pipelining -- the scheduler runs while the Future is pending, exactly
+        # like real GPU/CPU overlap.
+        emu_hook = self._emulator_executor_hook
+        if (
+            emu_hook is not None
+            and emu_hook.is_enabled
+            and emu_hook.should_use_oracle(scheduler_output)
+        ):
+            return emu_hook.create_delayed_future(scheduler_output, non_block=non_block)
+
         output = self.collective_rpc(
             "execute_model",
             args=(scheduler_output,),
@@ -123,6 +167,19 @@ class UniProcExecutor(Executor):
     def sample_tokens(  # type: ignore[override]
         self, grammar_output: GrammarOutput | None, non_block: bool = False
     ) -> ModelRunnerOutput | None | Future[ModelRunnerOutput | None]:
+        # Emulator: hand back the pending timer Future created by
+        # execute_model().  It resolves after the profiled step latency, which
+        # keeps the async scheduler's num_output_placeholders accounting -- and
+        # therefore its admission decisions -- identical to a real run.
+        emu_hook = self._emulator_executor_hook
+        if (
+            emu_hook is not None
+            and emu_hook.is_enabled
+            and emu_hook.has_pending_future()
+        ):
+            sample_future = emu_hook.get_sample_future()
+            return sample_future if non_block else sample_future.result()
+
         return self.collective_rpc(
             "sample_tokens",
             args=(grammar_output,),
@@ -141,6 +198,8 @@ class UniProcExecutor(Executor):
     def shutdown(self) -> None:
