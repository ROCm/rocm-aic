# Wire the LLM-Emu emulator (github.com/AKafakA/llm-emu) into vLLM v0.26.0.
#
# Two independent, env-gated features -- both no-ops when their env var is
# unset, so a normal GPU serve is bit-identical to stock vLLM:
#
#   VLLM_EMULATOR_EXECUTOR_HOOK=1  (+ VLLM_EMULATOR_ENABLE_ORACLE=1)
#     v1/executor/uniproc_executor.py short-circuits execute_model() /
#     sample_tokens() with a Future that resolves after a step latency drawn
#     from an offline profile pack.  vLLM's scheduler, KV-cache accounting,
#     tokenizer and HTTP stack all run unmodified -- only the forward pass is
#     replaced -- so the stack serves on a CPU-only node.
#     v1/engine/core.py gains the matching empty-batch / no-output guards
#     (both gated on self._emulator_enabled).
#
#   VLLM_EMULATOR_TRACE_STEP_CYCLE=1
#     v1/engine/core.py records one (total_tokens, concurrency, step_us)
#     sample per step on REAL hardware.  That trace is what
#     vllm_emulator.profile.build_serving_profile_filtered turns into the
#     profile pack the emulator replays -- i.e. this is how an MI300X/MI355X
#     profile pack gets captured in the first place.
#
# Ported from llm-emu's vllm_patches/llm-emu-vllm-0.18.1.patch.  Regenerated
# against v0.26.0 rather than rebased: v0.26.0 renamed log_iteration_details
# -> capture_iteration_details and gave Scheduler.schedule() an argument, so
# the upstream hunks no longer applied.  The upstream loop-timing printf
# instrumentation in run_busy_loop() and the cosmetic scheduler.py hunk are
# deliberately dropped (paper-benchmark scaffolding, no emulator function).
#
diff --git a/vllm/v1/engine/core.py b/vllm/v1/engine/core.py
index 476f53d..e7e4275 100644
--- a/vllm/v1/engine/core.py
+++ b/vllm/v1/engine/core.py
@@ -228,6 +228,42 @@ class EngineCore:
 
         self.aborts_queue = queue.Queue[list[str]]()
 
+        # --- LLM-Emu emulation hooks (opt-in via env, inert otherwise) ------
+        # VLLM_EMULATOR_ENABLE_ORACLE=1 makes the executor short-circuit the
+        # forward pass with a timer-resolved fake output (see
+        # v1/executor/uniproc_executor.py).  The guards in the step paths below
+        # only fire in that mode, so real serving is bit-identical.
+        # VLLM_EMULATOR_TRACE_STEP_CYCLE=1 is the reverse direction: it records
+        # one step-latency sample per step on REAL hardware, which
+        # vllm_emulator.profile.build_serving_profile_filtered turns into the
+        # profile pack the emulator later replays.
+        self._emulator_enabled = os.environ.get(
+            "VLLM_EMULATOR_ENABLE_ORACLE", ""
+        ).lower() in ("1", "true", "yes")
+        self._last_scheduler_output: SchedulerOutput | None = None
+        self._emulator_step_tracer = None
+        if os.environ.get("VLLM_EMULATOR_TRACE_STEP_CYCLE", "").lower() in (
+            "1",
+            "true",
+            "yes",
+        ):
+            try:
+                from vllm_emulator.profiler.trace_profiler import StepCycleTracer
+
+                self._emulator_step_tracer = StepCycleTracer(
+                    os.environ.get(
+                        "VLLM_EMULATOR_STEP_TRACE_OUTPUT",
+                        "/tmp/emulator_step_trace.jsonl",
+                    )
+                )
+                self._emulator_step_tracer.write_header(vllm_config)
+            except ImportError:
+                logger.warning(
+                    "VLLM_EMULATOR_TRACE_STEP_CYCLE is set but the "
+                    "vllm_emulator package is not installed; step-cycle "
+                    "tracing is disabled."
+                )
+
         self._idle_state_callbacks: list[Callable] = []
 
         # Mark the startup heap as static so that it's ignored by GC.
@@ -585,6 +621,8 @@ class EngineCore:
         if not self.scheduler.has_requests():
             return {}, False
         scheduler_output = self.scheduler.schedule(self._should_throttle_prefills())
+        # Batch context for the step-cycle tracer (emulator profile capture).
+        self._last_scheduler_output = scheduler_output
         future = self.model_executor.execute_model(scheduler_output, non_block=True)
         grammar_output = self.scheduler.get_grammar_bitmask(scheduler_output)
         with (
@@ -593,7 +631,15 @@ class EngineCore:
         ):
             model_output = future.result()
             if model_output is None:
+                if (
+                    self._emulator_enabled
+                    and scheduler_output.total_num_scheduled_tokens == 0
+                ):
+                    # Emulation mode: an empty batch produces no fake output.
+                    return {}, False
                 model_output = self.model_executor.sample_tokens(grammar_output)
+                if self._emulator_enabled and model_output is None:
+                    return {}, False
 
         # Before processing the model output, process any aborts that happened
         # during the model execution.
@@ -643,6 +689,8 @@ class EngineCore:
         deferred_scheduler_output = None
         if self.scheduler.has_requests():
             scheduler_output = self.scheduler.schedule(self._should_throttle_prefills())
+            # Batch context for the step-cycle tracer (emulator profile capture).
+            self._last_scheduler_output = scheduler_output
             with self.log_error_detail(scheduler_output):
                 exec_future = self.model_executor.execute_model(
                     scheduler_output, non_block=True
@@ -692,6 +740,12 @@ class EngineCore:
         ):
             model_output = future.result()
             if model_output is None:
+                if (
+                    self._emulator_enabled
+                    and scheduler_output.total_num_scheduled_tokens == 0
+                ):
+                    # Emulation mode: an empty batch produces no fake output.
+                    return {}, False
                 # None from sample_tokens() implies that the original execute_model()
                 # call failed - raise that exception.
                 exec_model_fut.result()
@@ -1399,6 +1453,11 @@ class EngineCoreProc(EngineCore):
     def _process_engine_step(self) -> bool:
         """Called only when there are unfinished local requests."""
 
+        # Optional: time the full step cycle for emulator profile capture
+        # (VLLM_EMULATOR_TRACE_STEP_CYCLE=1).  None -> no overhead at all.
+        step_tracer = self._emulator_step_tracer
+        step_t0 = time.perf_counter() if step_tracer is not None else 0.0
+
         # Step the engine core.
         outputs, model_executed = self.step_fn()
         # Put EngineCoreOutputs into the output queue.
@@ -1407,6 +1466,9 @@ class EngineCoreProc(EngineCore):
         # Post-step hook.
         self.post_step(model_executed)
 
+        if step_tracer is not None and model_executed:
+            self._record_emulator_step(step_tracer, step_t0)
+
         # If no model execution happened but there is still scheduler work
         # (e.g. WAITING_FOR_REMOTE_KVS or delayed KV connector frees), yield
         # the GIL briefly to allow background transfer threads to make progress.
@@ -1415,6 +1477,33 @@ class EngineCoreProc(EngineCore):
 
         return model_executed
 
+    def _record_emulator_step(self, step_tracer, step_t0: float) -> None:
+        """Record one step-latency sample for emulator profile capture.
+
+        The (total_tokens, concurrency) pair recorded here is the key the
+        emulator's oracle later buckets on, so it must describe the batch that
+        was just executed -- hence _last_scheduler_output rather than a fresh
+        schedule() call.
+        """
+        step_us = (time.perf_counter() - step_t0) * 1e6
+        so = self._last_scheduler_output
+        if so is not None and so.total_num_scheduled_tokens > 0:
+            new_req_ids = {r.req_id for r in so.scheduled_new_reqs}
+            num_decode = sum(
+                1 for rid in so.num_scheduled_tokens if rid not in new_req_ids
+            )
+            # sum_kv: total KV-cache depth across scheduled cached
+            # (decode + chunked-continuation) requests.
+            cached = so.scheduled_cached_reqs
+            sum_kv = sum(cached.num_computed_tokens) if cached.num_reqs > 0 else 0
+            step_tracer.set_batch_info(
+                total_tokens=so.total_num_scheduled_tokens,
+                num_new_reqs=len(so.scheduled_new_reqs),
+                num_decode_seqs=num_decode,
+                sum_kv=sum_kv,
+            )
+        step_tracer.record_step(step_us)
+
     def _notify_idle_state_callbacks(self) -> None:
         while self._idle_state_callbacks:
             callback = self._idle_state_callbacks.pop()
