+def build_3d_distribution(data, label):
+    """Build {(tt_b, conc_b, kv_b) -> [latency_us]} into bucket dicts.
+
+    The third axis is sum_kv, the batch's total KV depth.  Two steps with the
+    same scheduled-token count and concurrency but very different context
+    depths do NOT cost the same: measured on MI300X/Qwen3-8B, the high-sum_kv
+    quartile of a single (tt, conc) cell runs 1.13x-1.45x slower than the low
+    quartile, worst at high concurrency.  Bucketing that away is the largest
+    single source of replay error once cells are adequately sampled.
+    """
+    distribution = []
+    for (ttb, cb, kvb), lats in sorted(data.items()):
+        samples = [round(v, 1) for v in lats]
+        distribution.append({
+            "tt": ttb,
+            "conc": cb,
+            "kv": kvb,
+            "num_samples": len(samples),
+            "samples": samples,
+        })
+    print(f"  {label}: {len(distribution)} cells")
+    return distribution
+
