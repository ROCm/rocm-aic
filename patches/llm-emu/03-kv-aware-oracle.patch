+    def _sample_3d_distribution(
+        self, total_tokens: int, num_requests: int, sum_kv: int,
+        has_prefill: bool = False,
+    ) -> float | None:
+        """Sample from the (tt, conc, kv) bucket nearest the query.
+
+        Distance is Euclidean over the three axes, each normalised by its own
+        range so the axes are comparable (sum_kv spans tens of thousands while
+        tt spans thousands and conc tens).  K=1 takes the nearest cell; K>1 and
+        K=auto reuse the same Shepard inverse-distance weighting as the 2D
+        path, pooling neighbours until the sample floor is met -- which is what
+        keeps thin kv cells usable.
+        """
+        if has_prefill and self._prefill_3d_distribution:
+            table = self._prefill_3d_distribution
+        elif not has_prefill and self._decode_3d_distribution:
+            table = self._decode_3d_distribution
+        elif self._combined_3d_distribution:
+            table = self._combined_3d_distribution
+        else:
+            return None
+
+        keys = list(table.keys())
+        if not keys:
+            return None
+        tts = [k[0] for k in keys]
+        concs = [k[1] for k in keys]
+        kvs = [k[2] for k in keys]
+        tt_range = (max(tts) - min(tts)) or 1
+        conc_range = (max(concs) - min(concs)) or 1
+        kv_range = (max(kvs) - min(kvs)) or 1
+
+        def _dist(k):
+            dt = (k[0] - total_tokens) / tt_range
+            dc = (k[1] - num_requests) / conc_range
+            dk = (k[2] - sum_kv) / kv_range
+            return (dt * dt + dc * dc + dk * dk) ** 0.5
+
+        ranked = sorted(((_dist(k), k) for k in keys), key=lambda x: x[0])
+
+        if self._oracle_k_mode == "auto":
+            floor = self._oracle_k_min_samples
+        elif self._oracle_k > 1:
+            floor = 0
+        else:
+            # K=1: nearest populated cell.
+            for _d, k in ranked:
+                if table[k].get("samples"):
+                    return self._sample(table[k]["samples"])
+            return None
+
+        chosen = []
+        cum = 0
+        for d, k in ranked:
+            n = len(table[k].get("samples") or [])
+            if n == 0:
+                continue
+            chosen.append((d, k))
+            cum += n
+            if floor and cum >= floor:
+                break
+            if not floor and len(chosen) >= self._oracle_k:
+                break
+        if not chosen:
+            return None
+        if chosen[0][0] == 0.0 or len(chosen) == 1:
+            return self._sample(table[chosen[0][1]].get("samples"))
+
+        weights = [1.0 / (d * d) for d, _ in chosen]
+        total_w = sum(weights)
+        if total_w == 0:
+            return None
+        r = self._rng.random() * total_w
+        cum_w = 0.0
+        chosen_k = chosen[-1][1]
+        for (d, k), w in zip(chosen, weights):
+            cum_w += w
+            if r <= cum_w:
+                chosen_k = k
+                break
+        return self._sample(table[chosen_k].get("samples"))
