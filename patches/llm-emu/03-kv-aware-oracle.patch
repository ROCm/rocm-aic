+    def _sample_3d_distribution(
+        self, total_tokens: int, num_requests: int, sum_kv: int,
+        has_prefill: bool = False,
+    ) -> float | None:
+        """Sample from the (tt, conc, kv) bucket nearest the query.
+
+        Distance is Euclidean over the three axes, each normalised by its own
+        range so the axes are comparable (sum_kv spans tens of thousands while
+        tt spans thousands and conc tens).  K=1 takes the nearest cell; K>1 and
+        K=auto reuse the same Shepard inverse-distance weighting as the 2D
+        path, pooling neighbours until the sample floor is met -- which is what
+        keeps thin kv cells usable.
+        """
+        if has_prefill and self._prefill_3d_distribution:
+            table = self._prefill_3d_distribution
+        elif not has_prefill and self._decode_3d_distribution:
+            table = self._decode_3d_distribution
+        elif self._combined_3d_distribution:
+            table = self._combined_3d_distribution
+        else:
+            return None
+
+        # Hierarchical, NOT Euclidean-over-normalised-axes.  The KV tables
+        # REFINE the 2D cell; they do not replace the metric.  A single
+        # normalised distance lets a kv mismatch outvote a tt mismatch, and
+        # since tt is the dominant cost driver for prefill that produced
+        # 4x-too-cheap prefill steps in replay: a query for
+        # (tt=4096, conc=17, kv=17k) was answered by a low-tt cell whose kv
+        # happened to match, instead of the tt=4096 cell whose kv did not.
+        # So: pick the tt exactly as the 2D path does, then the concurrency
+        # within that tt, and only then the nearest KV depth within that cell.
+        tts_in_table = sorted({k[0] for k in table})
+        if not tts_in_table:
+            return None
+        if total_tokens <= tts_in_table[0]:
+            tt_near = tts_in_table[0]
+        elif total_tokens >= tts_in_table[-1]:
+            tt_near = tts_in_table[-1]
+        else:
+            tt_near = min(tts_in_table, key=lambda t: abs(t - total_tokens))
+
+        concs = sorted({k[1] for k in table if k[0] == tt_near})
+        if not concs:
+            return None
+        conc_near = min(concs, key=lambda c: abs(c - num_requests))
+
+        kv_keys = [k for k in table
+                   if k[0] == tt_near and k[1] == conc_near and table[k].get("samples")]
+        if not kv_keys:
+            return None
+        kv_keys.sort(key=lambda k: abs(k[2] - sum_kv))
+
+        if self._oracle_k_mode == "auto":
+            # Pool outwards along the KV axis only, nearest first, until the
+            # sample floor is met -- so a thin kv sub-cell borrows from its
+            # neighbours in the same (tt, conc) cell rather than from some
+            # unrelated batch shape.
+            chosen, cum = [], 0
+            for k in kv_keys:
+                chosen.append(k)
+                cum += len(table[k]["samples"])
+                if cum >= self._oracle_k_min_samples:
+                    break
+        else:
+            chosen = kv_keys[: max(self._oracle_k, 1)]
+
+        if len(chosen) == 1:
+            return self._sample(table[chosen[0]]["samples"])
+        pooled = [s for k in chosen for s in table[k]["samples"]]
+        return self._sample(pooled)
+
