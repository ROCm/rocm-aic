+# ---------------------------------------------------------------------------
+# Fake KV buffers for KV-connector emulation
+# ---------------------------------------------------------------------------
+# A KV connector (LMCache, NIXL, ...) is handed vLLM's paged KV tensors once,
+# at startup, via register_kv_caches().  Emulation never allocates them: the
+# executor hook fakes every step's output, so the buffers are dead weight --
+# until you want to emulate the connector too, at which point their absence is
+# the whole problem.  There is nothing device-specific about them from the
+# connector's point of view; they are paged byte buffers of a shape fixed by
+# (num_blocks, block_size, num_kv_heads, head_size, kv dtype), all of which
+# vLLM has already computed and put in the KVCacheConfig.  So synthesize them
+# in HOST memory and register those.
+#
+# LMCache in particular needs no changes to accept them: its device detection
+# resolves to StubCPUDevice, and lmcache/v1/platform/cpu/shm.py migrates a CPU
+# tensor's storage into a POSIX SHM segment so the mp server can map it --
+# the same server-pull topology as HIP IPC on a real GPU, minus the GPU.
+#
+# Sizing: these are the full pool vLLM asked for, which on a real MI300X pack
+# is the captured available_kv_cache_bytes (~100+ GiB).  torch.zeros on CPU is
+# lazily backed, so untouched blocks cost no resident memory and RSS grows
+# only as blocks are actually written.  VLLM_EMULATOR_MEMORY shrinks the
+# emulated pool -- and therefore the emulated cliff -- to fit the node.
+# VLLM_EMULATOR_KV_BUFFERS=0 opts out entirely (no connector emulation).
+
+def _synthesize_kv_caches(kv_cache_config) -> dict:
+    """Build {layer_name: host tensor} matching vLLM's paged KV layout.
+
+    Sized from ``kv_cache_config`` rather than from the HF config: vLLM has
+    already turned the memory budget into an exact per-tensor byte count, and
+    that count is what the connector will move.
+    """
+    import torch as _t
+    from vllm.v1.kv_cache_interface import AttentionSpec
+
+    spec_by_layer = {}
+    for group in kv_cache_config.kv_cache_groups:
+        for layer_name in group.layer_names:
+            spec_by_layer[layer_name] = group.kv_cache_spec
+
+    kv_caches: dict = {}
+    total_bytes = 0
+    for tensor_cfg in kv_cache_config.kv_cache_tensors:
+        if not tensor_cfg.shared_by:
+            continue
+        spec = spec_by_layer.get(tensor_cfg.shared_by[0])
+        if not isinstance(spec, AttentionSpec):
+            # Mamba / encoder-only / other non-attention groups: no paged KV
+            # for a connector to move, so nothing to fake.
+            continue
+        page_size = spec.page_size_bytes
+        if page_size <= 0:
+            continue
+        num_blocks = tensor_cfg.size // page_size
+        if num_blocks <= 0:
+            continue
+        shape = (2, num_blocks, spec.block_size, spec.num_kv_heads, spec.head_size)
+        buf = _t.zeros(shape, dtype=spec.dtype, device="cpu")
+        total_bytes += buf.numel() * buf.element_size()
+        for layer_name in tensor_cfg.shared_by:
+            kv_caches[layer_name] = buf
+
+    if kv_caches:
+        print(f"[EmulatorKVBuffers] synthesized {len(kv_caches)} layer buffers, "
+              f"{total_bytes / 1024**3:.1f} GiB of host-backed fake KV "
+              f"(lazily paged; cap with VLLM_EMULATOR_MEMORY)")
+    return kv_caches
+
+
+def _maybe_init_kv_connector(worker, kv_cache_config) -> None:
+    """Create the worker-side KV connector and register fake KV buffers.
+
+    The real Worker.initialize_from_config does exactly this before handing
+    off to the model runner; the emulator stub replaced the whole method, so
+    without this the worker-side connector is never constructed
+    (has_kv_transfer_group() stays False) and the executor hook has nothing to
+    drive.  No-op when the serve has no --kv-transfer-config.
+    """
