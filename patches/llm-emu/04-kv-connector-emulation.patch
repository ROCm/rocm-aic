+        # may not even have the import.
+        print(f"[EmulatorKVBuffers] set_host_xfer_buffer_ops skipped: {e}")
+
+    print(f"[EmulatorKVBuffers] registered {len(kv_caches)} fake KV buffers with "
+          f"{type(connector).__name__}")
+
