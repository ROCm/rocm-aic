+    if vllm_config is None or getattr(vllm_config, "kv_transfer_config", None) is None:
+        return
+    if os.environ.get("VLLM_EMULATOR_KV_BUFFERS", "1").lower() in ("0", "false", "no"):
+        print("[EmulatorKVBuffers] VLLM_EMULATOR_KV_BUFFERS=0 → KV connector "
+              "NOT initialized; --kv-transfer-config will be inert")
+        return
+
+    try:
+        from vllm.distributed.kv_transfer import (
+            ensure_kv_transfer_initialized,
+            get_kv_transfer_group,
+            has_kv_transfer_group,
+        )
+    except ImportError as e:
+        print(f"[EmulatorKVBuffers] vLLM KV-transfer API unavailable: {e}")
+        return
+
+    try:
+        ensure_kv_transfer_initialized(vllm_config, kv_cache_config)
+    except TypeError:
+        # Older vLLM took only the config.
+        ensure_kv_transfer_initialized(vllm_config)
+    if not has_kv_transfer_group():
+        print("[EmulatorKVBuffers] no KV transfer group after init; "
+              "connector emulation disabled")
+        return
+
+    connector = get_kv_transfer_group()
+    kv_caches = _synthesize_kv_caches(kv_cache_config)
+    if not kv_caches:
+        print("[EmulatorKVBuffers] no attention groups to fake; "
+              "connector registered with no buffers")
+        return
+
+    connector.register_kv_caches(kv_caches)
+    # Keep the buffers alive for the process lifetime: nothing else holds a
+    # reference, and the connector may only keep a wrapper/handle.
+    worker._emulator_kv_caches = kv_caches
+    if hasattr(worker, "model_runner") and worker.model_runner is not None:
+        worker.model_runner.kv_caches = list(kv_caches.values())
+
+    try:
+        from vllm.distributed.kv_transfer.kv_connector.utils import copy_kv_blocks
+        connector.set_host_xfer_buffer_ops(copy_kv_blocks)
+    except Exception as e:
