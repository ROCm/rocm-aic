+def _kv_cache_dtype(cache_config, model_config):
+    """Resolve the KV-cache torch dtype the way vLLM's model runner does.
+
+    ``--kv-cache-dtype fp8`` halves page_size_bytes relative to the model
+    dtype, so getting this wrong moves the emulated KV-admission point and
+    missizes anything a KV connector registers.
+    """
+    try:
+        from vllm.utils.torch_utils import kv_cache_dtype_str_to_dtype
+        return kv_cache_dtype_str_to_dtype(cache_config.cache_dtype, model_config)
+    except Exception as e:
+        print(f"[EmulatorCudaMock] kv dtype fallback to model dtype: {e}")
+        return model_config.dtype
