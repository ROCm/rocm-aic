-            print(f"[EmulatorCudaMock] gpu_worker.init_device fallback: {e}")
+            # Name the exception type: several of the ones seen here
+            # (NotImplementedError from a Platform method the emulator
+            # platform lacks, a bare AssertionError) have an empty message.
+            print(f"[EmulatorCudaMock] gpu_worker.init_device fallback: "
+                  f"{type(e).__name__}: {e}")
             try:
-                from vllm.v1.worker.gpu_model_runner import GPUModelRunner
