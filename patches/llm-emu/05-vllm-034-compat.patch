+    # is nothing to pool.
+    if hasattr(cls, '_maybe_get_memory_pool_context'):
+        from contextlib import nullcontext
+
+        def _no_memory_pool_context(self, tag=None):
+            return nullcontext()
+        cls._maybe_get_memory_pool_context = _no_memory_pool_context
+
     def _noop_load_model(self, *a, **kw):
         print("[EmulatorCudaMock] gpu_worker.Worker.load_model SKIPPED "
               "(emulator drives latency from profile pack)")
@@ -414,7 +438,12 @@ def _patch_gpu_worker(module):
         else:
             total = 80 * 1024**3
             src = "default-80GB (no profile loaded)"
-        util = float(getattr(self.cache_config, "gpu_memory_utilization", 0.9))
+        # vLLM >= 0.34: gpu_memory_utilization is None unless the flag was
+        # given, and the effective value is resolved_gpu_memory_utilization.
+        util = getattr(self.cache_config, "resolved_gpu_memory_utilization", None)
+        if util is None:
+            util = getattr(self.cache_config, "gpu_memory_utilization", None)
+        util = float(util) if util is not None else 0.9
         requested = int(total * util)
         weights = _estimate_weights_bytes(self.model_config)
         activations = 1 * 1024**3
@@ -507,6 +536,12 @@ def _patch_gpu_worker(module):
         if getattr(kv_cache_config, "kv_cache_layout", None) is not None:
             from vllm.v1.attention.backends.utils import record_kv_cache_layout
             record_kv_cache_layout(self.cache_config, kv_cache_config.kv_cache_layout)
+        # vLLM >= 0.34 also adopts the engine core's prefix-cache granularity
+        # here, for the same reason.
+        for _attr in ("hash_block_size", "cache_hit_alignment_tokens"):
+            if hasattr(kv_cache_config, _attr):
+                setattr(self.cache_config, _attr,
+                        getattr(kv_cache_config, _attr))
         print("[EmulatorCudaMock] gpu_worker.Worker.initialize_from_config "
               "→ stored kv_cache_config (no GPU alloc)")
         _maybe_init_kv_connector(self, kv_cache_config)
@@ -835,6 +870,10 @@ def install():
         def _noop_factory(name, _mem=fake_memory):
             lname = name.lower()
             def _noop(*a, **kw):
+                # torch.accelerator.get_memory_info() -> (free, total), which
+                # vLLM >= 0.34's MemorySnapshot unpacks in Worker.init_device.
+                if 'memory_info' in lname:
+                    return (_mem, _mem)
                 if 'memory_stats' in lname or 'stats' in lname:
                     return {}
                 if 'memory' in lname and any(s in lname for s in
@@ -904,11 +943,17 @@ def install_model_stubs():
         return False
     print("[EmulatorModelStubs] Installing model-load stubs "
           "(no weights, no profile_run; hook+oracle drive latency)")
-    _install_module_patcher(
-        'vllm.v1.worker.gpu_model_runner',
-        _patch_gpu_model_runner,
-        'GPUModelRunner (synchronize_input_prep+load_model+profile_run)',
-    )
+    # The model runner moved: vllm.v1.worker.gpu_model_runner up to v0.29,
+    # vllm.v1.worker.gpu.model_runner (the only runner) since v0.34.  Arm
+    # both; a patcher for a module that is never imported never fires.
+    for _target in ('vllm.v1.worker.gpu_model_runner',
+                    'vllm.v1.worker.gpu.model_runner'):
+        _install_module_patcher(
+            _target,
+            _patch_gpu_model_runner,
+            f'GPUModelRunner [{_target}] '
+            '(synchronize_input_prep+load_model+profile_run)',
+        )
     _install_module_patcher(
         'vllm.v1.worker.gpu_worker',
         _patch_gpu_worker,
