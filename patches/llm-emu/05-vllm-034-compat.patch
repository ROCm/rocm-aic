+                    self.model_runner = GPUModelRunner(
+                        vllm_config=self.vllm_config, device=self.device)
                 print("[EmulatorCudaMock] built model_runner manually post-fallback")
             except Exception as e2:
-                print(f"[EmulatorCudaMock] model_runner manual build failed: {e2}; "
-                      f"installing stub")
+                print(f"[EmulatorCudaMock] model_runner manual build failed: "
+                      f"{type(e2).__name__}: {e2}; installing stub")
                 # Stub: provide every method the engine might call on
                 # model_runner as a no-op. Skip-everything proxy.
                 class _StubRunner:
@@ -336,6 +347,19 @@ def _patch_gpu_worker(module):
                 self.model_runner = _StubRunner()
     cls.init_device = _patched_init_device
 
+    # vLLM >= 0.34 wraps the model-runner build (and the weight load and KV
+    # allocation stubbed below) in a sleep-mode allocator pool, and resolves
+    # the allocator by platform: CUDA-alike, XPU and CPU are handled, anything
