# Capture what the emulator needs to reproduce the machine, and stop losing or
# poisoning samples.
#
# 1. StepCycleTracer.write_header() now records
#      available_kv_cache_bytes (via **extra from the call site), num_gpu_blocks,
#      gpu_memory_utilization, max_num_batched_tokens, max_num_seqs,
#      enable_prefix_caching, enable_chunked_prefill, kv_cache_dtype,
#      async_scheduling, eos_token_id, vllm_version
#    cuda_mock already PREFERS model_config.gpu.available_kv_cache_bytes over
#    its "total x util - guessed weights" estimate, and that value is what puts
#    the emulated KV-admission point where the real one was -- the whole reason
#    to emulate a cache cliff.  The rest makes a pack self-describing: it is
#    only valid for the serving configuration it was captured under, so that
#    configuration belongs IN the pack, not in a sidecar README.
#
# 2. The tracer keeps ONE append handle open instead of open()/close()-ing every
#    200 records.  On a shared filesystem that syscall pair stalls the engine
#    loop and the stall lands in the NEXT step's measurement -- we saw isolated
#    128ms "decode" steps and one 1.2s "prefill" in a 113-token cell, which the
#    oracle then samples uniformly.
#
# 3. close() is registered with atexit, so the tail of the trace (up to 199
#    records) is no longer dropped when the server shuts down.
#
# 4. The profile builder propagates the new header fields into the pack.
#
diff --git a/vllm_emulator/profile/build_serving_profile_filtered.py b/vllm_emulator/profile/build_serving_profile_filtered.py
index 23861b4..9d6e6c6 100644
--- a/vllm_emulator/profile/build_serving_profile_filtered.py
+++ b/vllm_emulator/profile/build_serving_profile_filtered.py
@@ -75,10 +75,20 @@ def extract_metadata(trace_header, cli_model_name, cli_gpu_model):
         _MC_KEYS = ("num_hidden_layers", "hidden_size", "num_attention_heads",
                      "num_key_value_heads", "vocab_size", "intermediate_size",
                      "head_dim", "max_model_len", "block_size",
-                     "eos_token_id")
+                     "eos_token_id",
+                     # Serving configuration the pack is only valid for.
+                     "max_num_batched_tokens", "max_num_seqs",
+                     "enable_chunked_prefill", "enable_prefix_caching",
+                     "kv_cache_dtype", "async_scheduling",
+                     "gpu_memory_utilization", "num_gpu_blocks",
+                     "vllm_version")
         model_config = {k: trace_header[k] for k in _MC_KEYS if k in trace_header}
+        # available_kv_cache_bytes is the KV pool vLLM measured on the real
+        # GPU; cuda_mock prefers it over its estimate, which is what makes the
+        # emulated KV-admission point match the captured machine.
         _GPU_KEYS = ("gpu_name", "gpu_memory_bytes", "gpu_sm_count",
-                      "gpu_compute_capability", "gpu_count")
+                      "gpu_compute_capability", "gpu_count",
+                      "available_kv_cache_bytes")
         gpu_config = {k: trace_header[k] for k in _GPU_KEYS if k in trace_header}
         if gpu_config:
             model_config["gpu"] = gpu_config
diff --git a/vllm_emulator/profiler/trace_profiler.py b/vllm_emulator/profiler/trace_profiler.py
