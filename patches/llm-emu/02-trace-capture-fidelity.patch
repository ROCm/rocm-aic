-    def write_header(self, vllm_config: Any) -> None:
+        # One open append handle for the whole run.  flush() used to open and
+        # close the file every 200 steps; on a shared filesystem that syscall
+        # pair stalls the engine loop, and the stall lands in the NEXT step's
+        # measurement -- visible as isolated 100ms+ "decode" samples that then
