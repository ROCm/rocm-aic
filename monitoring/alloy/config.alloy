// AIC Alloy config — collect Docker container logs and ship to Loki.
// Discovers this stack's running containers via the Docker socket, tails their
// stdout/stderr, and labels each stream with the container name so
// Grafana can filter by service (aic-vllm-gpu0, aic-lmcache, etc.).

// Only this stack's compose project (AIC_STACK, from the compose service): the
// node's Docker daemon also runs other stacks and other tenants' containers.
discovery.docker "aic_containers" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("AIC_STACK")]
  }
}

// Relabel: extract container_name (strip leading '/') and image.  The stack
// prefix becomes the fixed aic- the dashboard queries by, so any stack's vLLM
// is labelled aic-vllm-gpu0 rather than <stack>-vllm-gpu0.
discovery.relabel "aic_containers" {
  targets = discovery.docker.aic_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = string.format("/%s-(.*)", sys.env("AIC_STACK"))
    replacement   = "aic-$1"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
}

loki.source.docker "aic_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.aic_containers.output
  forward_to = [loki.write.aic_loki.receiver]

  labels = {
    job = "docker",
  }
}

// Tail the AIC benchmark conversation log — written by aic_bench_serve.py
// so each conversation (prompt + response) appears in Grafana as a log entry.
local.file_match "bench_conversations" {
  path_targets = [{"__path__" = "/tmp/aic-conversations.log",
                   "job"      = "aic_bench",
                   "container" = "host"}]
}

loki.source.file "bench_conversations" {
  targets    = local.file_match.bench_conversations.targets
  forward_to = [loki.write.aic_loki.receiver]
}

loki.write "aic_loki" {
  endpoint {
    url = "http://aic-loki:3100/loki/api/v1/push"
  }
}
