# Python
.venv
__pycache__/
*.pyc
*.egg-info/

# VSCode
.vscode/

# Large archives
*.tgz

# Benchmark CSVs, plots, container logs and the Prometheus TSDB all land under
# logs/<job-id>/ (or logs/manual/ for non-Slurm runs) -- one ignored tree.
logs/

# Slurm job logs written to the tree root
*.out
spur-*.out
rdma-test-*.out
rdma-test-*.err

# `make export` artifacts (aic-<date>-<rev>.tar.gz by default).
/*.tar.gz

# Debian package files
*.deb

# Codespell dictionary cache
dictionary.dic

# AI assistant / tool caches
.claude/
.cline_storage/
.mypy_cache/

# Per-cluster environment files read by the Makefile and
# .slurm/run-build-distribute.sh (.env.alola, .env.spur, ...).  These describe
# one site and are where a private path or token ends up; never commit one.
# Example files are tracked so the knobs stay discoverable.
.env.*
!.env.*.example

# CI artifact staging dir (spur-monitoring-cpu-smoke.sh copies index.html here
# for upload-artifact / gh-pages deploy; never committed)
metrics-page/

# Profile capture working directory (raw traces, bench results)
profiles/captures/

rocjitsu-page/
rocjitsu-out/

# Prometheus raw metrics dump
prometheus-dump.md

# Overnight testing files
overnight*.md
 
.nfs*
wheels-out/
